{
  "name": "Videcutto",
  "short_name": "Videcutto",
  "description": "Videos go cut & play! Cut, join and shrink videos right in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#131313",
  "background_color": "#131313",
  "icons": [
    {
      "src": "/icons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*",
            "audio/*",
            ".mp4",
            ".mov",
            ".m4v",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".mp3",
            ".m4a",
            ".wav"
          ]
        }
      ]
    }
  }
}
